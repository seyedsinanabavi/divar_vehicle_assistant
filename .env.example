# مسیر دیتابیس و گزارش
DIVAR_DB_PATH=divar_bot.sqlite3
DIVAR_LOG_PATH=divar_bot.log

# حالت امن: 1 یعنی فقط شبیه‌سازی، هیچ پیامی ارسال نمی‌شود.
DIVAR_DRY_RUN=1

# فیلترهای اختیاری؛ قیمت‌ها به ریال
DIVAR_MIN_PRICE=
DIVAR_MAX_PRICE=
DIVAR_MAX_AGE_DAYS=

# متن پیام نمونه را با پیام خودتان عوض کنید
DIVAR_MESSAGE_TEXT=سلام، وقت بخیر. آگهی خودروی شما رو دیدم؛ آیا هنوز موجوده؟ امکان صحبت درباره جزئیات و شرایط معامله هست؟
DIVAR_POLL_SECONDS=60

# Official Divar Kenar OAuth (fill from Kenar developer panel)
DIVAR_CLIENT_ID=
DIVAR_CLIENT_SECRET=
# Must exactly match a redirect URI registered in Kenar panel.
# For local development, register a loopback URL if the panel allows it.
DIVAR_REDIRECT_URI=http://127.0.0.1:8765/callback
# Use only scopes approved for your app. Message scope may require a conversation-specific identifier.
DIVAR_OAUTH_SCOPES=offline_access
DIVAR_TOKEN_FILE=divar_tokens.json
